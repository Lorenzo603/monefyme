{"type":"message_start","message":{"role":"toolResult","toolCallId":"call_9d184506e26a415d951f4135","toolName":"bash","content":[{"type":"text","text":"package com.lorenzo.monefyme.ui.viewmodel\r\n\r\nimport androidx.lifecycle.ViewModel\r\nimport androidx.lifecycle.ViewModelProvider\r\nimport com.lorenzo.monefyme.data.repository.BudgetRepository\r\nimport com.lorenzo.monefyme.data.model.CategoryItem\r\nimport com.lorenzo.monefyme.data.model.ExpenseSlice\r\nimport com.lorenzo.monefyme.data.model.TransactionListItem\r\nimport com.lorenzo.monefyme.domain.CsvImportResult\r\nimport com.lorenzo.monefyme.domain.TransactionDraft\r\nimport java.io.InputStream\r\nimport java.time.YearMonth\r\nimport kotlinx.coroutines.Dispatchers\r\nimport kotlinx.coroutines.ExperimentalCoroutinesApi\r\nimport kotlinx.coroutines.flow.Flow\r\nimport kotlinx.coroutines.flow.emptyFlow\r\nimport kotlinx.coroutines.test.UnconfinedTestDispatcher\r\nimport kotlinx.coroutines.test.resetMain\r\nimport kotlinx.coroutines.test.setMain\r\nimport org.junit.After\r\nimport org.junit.Assert.assertNotNull\r\nimport org.junit.Before\r\nimport org.junit.Test\r\n\r\n@OptIn(ExperimentalCoroutinesApi::class)\r\nclass MainViewModelFactoryTest {\r\n    private val repository = object : BudgetRepository {\r\n        override fun observeCategoryNames(): Flow<List<String>> = emptyFlow()\r\n        override fun observeCategories(): Flow<List<CategoryItem>> = emptyFlow()\r\n        override fun observeMonthTransactions(month: YearMonth): Flow<List<TransactionListItem>> = emptyFlow()\r\n        override fun observeMonthExpenseSlices(month: YearMonth): Flow<List<ExpenseSlice>> = emptyFlow()\r\n        override suspend fun saveCategory(displayName: String, iconName: String, colorArgb: Int) = true\r\n        override suspend fun updateCategory(categoryId: Long, displayName: String, iconName: String, colorArgb: Int) = true\r\n        override suspend fun deleteCategory(categoryId: Long) = true\r\n        override suspend fun saveTransaction(transactionId: Long?, draft: TransactionDraft) = true\r\n        override suspend fun deleteTransaction(transactionId: Long) {}\r\n        override suspend fun importCsv(inputStream: InputStream): CsvImportResult = CsvImportResult(0, 0, 0, 0)\r\n    }\r\n\r\n    @Before\r\n    fun setUp() {\r\n        Dispatchers.setMain(UnconfinedTestDispatcher())\r\n    }\r\n\r\n    @After\r\n    fun tearDown() {\r\n        Dispatchers.resetMain()\r\n    }\r\n\r\n    @Test\r\npackage com.lorenzo.monefyme.ui.category\n\nimport org.junit.Assert.assertEquals\nimport org.junit.Assert.assertNotNull\nimport org.junit.Assert.assertNull\nimport org.junit.Assert.assertSame\nimport org.junit.Test\n\nclass CategoryIconRegistryTest {\n    @Test\n    fun iconNamesAreUnique() {\n        val names = CategoryIconRegistry.all.map { it.name }\n        assertEquals(names.size, names.toSet().size)\n    }\n\n    @Test\n    fun everyRegisteredIconResolvesToAVector() {\n        CategoryIconRegistry.all.forEach { option ->\n            assertNotNull(option.vector)\n            assertSame(option.vector, CategoryIconRegistry.findByName(option.name))\n        }\n    }\n\n    @Test\n    fun unknownIconNameResolvesToNull() {\n        assertNull(CategoryIconRegistry.findByName(\"NoSuchIcon\"))\n        // Registry lookups are case sensitive; default categories use registry names.\n        assertNull(CategoryIconRegistry.findByName(\"shoppingcart\"))\n    }\n\n    @Test\n    fun defaultIconIsPartOfTheRegistry() {\n        assertNotNull(CategoryIconRegistry.default)\n    }\n}\n"}],"isError":false,"durationMs":90,"timestamp":1793736083737}}
