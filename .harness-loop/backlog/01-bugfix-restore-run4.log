droidx.compose.ui.unit.dp\r\nimport androidx.compose.ui.window.Dialog\r\nimport com.lorenzo.monefyme.data.model.CategoryItem\r\nimport com.lorenzo.monefyme.ui.category.CategoryIconRegistry\r\nimport com.lorenzo.monefyme.ui.category.resolveColor\r\nimport com.lorenzo.monefyme.ui.category.resolveIcon\r\nimport kotlinx.coroutines.launch\r\n\r\nprivate val AppGreen = Color(0xFF74C792)\r\nprivate val AppBackground = Color(0xFFEAF8F2)\r\nprivate val AppTextPrimary = Color(0xFF2D3336)\r\nprivate val AppTextSecondary = Color(0xFF4B5558)\r\nprivate val AppTextMuted = Color(0xFF95A2A3)\r\nprivate val AppDivider = Color(0xFFD4EDE0)\r\n\r\nprivate val colorPalette = listOf(\r\n    Color(0xFFC49B00), Color(0xFF99631E), Color(0xFF7788A3),\r\n    Color(0xFFA665CA), Color(0xFFAFA0BE), Color(0xFF7EB7A4),\r\n    Color(0xFFC28B47), Color(0xFFDE6CA5), Color(0xFFB5A8B8),\r\n    Color(0xFFD95A5A), Color(0xFF6EA9E6), Color(0xFF67B68C),\r\n    Color(0xFF6AB8B1), Color(0xFFC78A00), Color(0xFF5E7EA5),\r\n    Color(0xFFDF6E75), Color(0xFF74C792), Color(0xFF8F9A9D),\r\n    Color(0xFFE07B42), Color(0xFF5B8C5A),\r\n)\r\n\r\n@Composable\r\nfun CategoriesSidebar(\r\n    categories: List<CategoryItem>,\r\n    onAddCategory: suspend (displayName: String, iconName: String, colorArgb: Int) -> Boolean,\r\n    onEditCategory: suspend (categoryId: Long, displayName: String, iconName: String, colorArgb: Int) -> Boolean,\r\n    onDeleteCategory: suspend (categoryId: Long) -> Boolean,\r\n    onClose: () -> Unit,\r\n    onOpenRestore: () -> Unit = {},\r\n) {\r\n    var showCategories by remember { mutableStateOf(false) }\r\n    var showAddDialog by remember { mutableStateOf(false) }\r\n    var selectedCategory by remember { mutableStateOf<CategoryItem?>(null) }\r\n    var showEditDialog by remember { mutableStateOf(false) }\r\n\r\n    BackHandler(enabled = showCategories) {\r\n        if (selectedCategory != null) {\r\n            selectedCategory = null\r\n        } else {\r\n            showCategories = false\r\n        }\r\n    }\r\n\r\n    Surface(\r\n        modifier = Modifier\r\n            .fillMaxHeight()\r\n            .width(280.dp),\r\n        color = AppBackground,\r\n        shadowElevation = 8.dp,\r\n    ) {\r\n        Column(modifier = Modifier.fillMaxSize()) {\r\n            SidebarHeader(\r\n                showingCategories = showCategories,\r\n                onBack = { showCategories = false },\r\n                onClose = onClose,\r\n            )\r\n            if (!showCategories) {\r\n                MenuBody(\r\n                    onOpenCategories = { showCategories = true },\r\n                    onOpenRestore = onOpenRestore,\r\n                )\r\n            } else {\r\n                CategoriesBody(\r\n                    categories = categories,\r\n                    onAddCategory = { showAddDialog = true },\r\n                    onCategoryClick = { category ->\r\n                        selectedCategory = category\r\n                        showEditDialog = true\r\n                    },\r\n                )\r\n            }\r\n        }\r\n    }\r\n\r\n    if (showAddDialog) {\r\n        AddCategoryDialog(\r\n            onDismiss = { showAddDialog = false },\r\n            onSave = { name, iconName, argb ->\r\n                val success = onAddCategory(name, iconName, argb)\r\n                if (success) showAddDialog = false\r\n                success\r\n            },\r\n        )\r\n    }\r\n\r\n    if (showEditDialog && selectedCategory != null) {\r\n        EditCategoryDialog(\r\n            category = selectedCategory!!,\r\n            onDismiss = {\r\n                showEditDialog = false\r\n                selectedCategory = null\r\n            },\r\n            onUpdate = { categoryId, displayName, iconName, colorArgb ->\r\n                val success = onEditCategory(categoryId, displayName, iconName, colorArgb)\r\n                if (success) {\r\n                    showEditDialog = false\r\n                    selectedCategory = null\r\n                }\r\n                success\r\n            },\r\n            onDelete = { categoryId ->\r\n                val success = onDeleteCategory(categoryId)\r\n                if (success) {\r\n                    showEditDialog = false\r\n                    selectedCategory = null\r\n                }\r\n                success\r\n            },\r\n        )\r\n    }\r\n}\r\n\r\n@Composable\r\nprivate fun SidebarHeader(\r\n    showingCategories: Boolean,\r\n    onBack: () -> Unit,\r\n    onClose: () -> Unit,\r\n) {\r\n    Surface(color = AppGreen) {\r\n        Row(\r\n            modifier = Modifier\r\n                .fillMaxWidth()\r\n                .height(56.dp),\r\n            horizontalArrangement = Arrangement.SpaceBetween,\r\n            verticalAlignment = Alignment.CenterVertically,\r\n        ) {\r\n            if (showingCategories) {\r\n                IconButton(onClick = onBack) {\r\n                    Icon(Icons.AutoMirrored.Outlined.ArrowBack, contentDescription = \"Back\", tint = Color.White)\r\n                }\r\n                Text(\r\n                    text = \"Categories\",\r\n                    color = Color.White,\r\n                    style = MaterialTheme.typography.titleMedium,\r\n                    fontWeight = FontWeight.SemiBold,\r\n                )\r\n                Spacer(Modifier.width(48.dp))\r\n            } else {\r\n                Spacer(Modifier.width(48.dp))\r\n                IconButton(onClick = onClose) {\r\n                    Icon(Icons.Outlined.Close, contentDescription = \"Close\", tint = Color.White)\r\n                }\r\n            }\r\n        }\r\n    }\r\n}\r\n\r\n@Composable\r\nprivate fun MenuBody(\r\n    onOpenCategories: () -> Unit,\r\n    onOpenRestore: () -> Unit,\r\n) {\r\n    Column {\r\n        HorizontalDivider(color = AppDivider)\r\n        Row(\r\n            modifier = Modifier\r\n                .fillMaxWidth()\r\n                .clickable(onClick = onOpenCategories)\r\n                .padding(horizontal = 16.dp, vertical = 16.dp),\r\n            verticalAlignment = Alignment.CenterVertically,\r\n            horizontalArrangement = Arrangement.SpaceBetween,\r\n        ) {\r\n            Text(\r\n                text = \"Categories\",\r\n                style = MaterialTheme.typography.bodyLarge,\r\n                color = AppTextPrimary,\r\n                fontWeight = FontWeight.Medium,\r\n            )\r\n            Icon(\r\n                Icons.Outlined.ChevronRight,\r\n                contentDescription = null,\r\n                tint = AppGreen,\r\n            )\r\n        }\r\n        HorizontalDivider(color = AppDivider)\r\n        Row(\r\n            modifier = Modifier\r\n                .fillMaxWidth()\r\n                .clickable(onClick = onOpenRestore)\r\n                .padding(horizontal = 16.dp, vertical = 16.dp),\r\n            verticalAlignment = Alignment.CenterVertically,\r\n            horizontalArrangement = Arrangement.SpaceBetween,\r\n        ) {\r\n            Text(\r\n                text = \"Restore\",\r\n                style = MaterialTheme.typography.bodyLarge,\r\n                color = AppTextPrimary,\r\n                fontWeight = FontWeight.Medium,\r\n            )\r\n            Icon(\r\n                Icons.Outlined.Restore,\r\n                contentDescription = null,\r\n                tint = AppGreen,\r\n            )\r\n        }\r\n        HorizontalDivider(color = AppDivider)\r\n    }\r\n}\r\n\r\n@Composable\r\nprivate fun CategoriesBody(\r\n    categories: List<CategoryItem>,\r\n    onAddCategory: () -> Unit,\r\n    onCategoryClick: (CategoryItem) -> Unit,\r\n) {\r\n    Column(modifier = Modifier.fillMaxSize()) {\r\n        HorizontalDivider(color = AppDivider)\r\n        LazyColumn(modifier = Modifier.weight(1f)) {\r\n            items(categories, key = { it.id }) { category ->\r\n                CategoryRow(category, onClick = { onCategoryClick(category) })\r\n                HorizontalDivider(color = AppDivider)\r\n            }\r\n            if (categories.isEmpty()) {\r\n                item {\r\n                    Text(\r\n                        text = \"No categories yet.\",\r\n                        modifier = Modifier.padding(16.dp),\r\n                        color = AppTextMuted,\r\n                        style = MaterialTheme.typography.bodySmall,\r\n                    )\r\n                }\r\n            }\r\n        }\r\n        HorizontalDivider(color = AppDivider)\r\n        Box(\r\n            modifier = Modifier\r\n                .fillMaxWidth()\r\n                .padding(horizontal = 16.dp, vertical = 12.dp),\r\n        ) {\r\n            OutlinedButton(\r\n                onClick = onAddCategory,\r\n                modifier = Modifier\r\n                    .fillMaxWidth()\r\n                    .height(48.dp),\r\n                shape = RoundedCornerShape(8.dp),\r\n                border = BorderStroke(1.5.dp, AppGreen),\r\n                colors = ButtonDefaults.outlinedButtonColors(\r\n                    containerColor = AppBackground,\r\n                    contentColor = AppTextSecondary,\r\n                ),\r\n            ) {\r\n                Icon(\r\n                    Icons.Outlined.Add,\r\n                    contentDescription = null,\r\n                    modifier = Modifier.size(18.dp),\r\n                )\r\n                Spacer(Modifier.width(8.dp))\r\n                Text(\"Add Category\")\r\n            }\r\n        }\r\n    }\r\n}\r\n\r\n@Composable\r\nprivate fun CategoryRow(item: CategoryItem, onClick: () -> Unit) {\r\n    Row(\r\n        modifier = Modifier\r\n            .fillMaxWidth()\r\n            .padding(horizontal = 16.dp, vertical = 12.dp)\r\n            .clickable(onClick = onClick),\r\n        verticalAlignment = Alignment.CenterVertically,\r\n    ) {\r\n        Box(\r\n            modifier = Modifier\r\n                .size(36.dp)\r\n                .clip(CircleShape)\r\n                .background(item.resolveColor()),\r\n            contentAlignment = Alignment.Center,\r\n        ) {\r\n            Icon(\r\n                imageVector = item.resolveIcon(),\r\n                contentDescription = null,\r\n                tint = Color.White,\r\n                modifier = Modifier.size(20.dp),\r\n            )\r\n        }\r\n        Spacer(Modifier.width(14.dp))\r\n        Text(\r\n            text = item.displayName,\r\n            style = MaterialTheme.typography.bodyMedium,\r\n            color = AppTextPrimary,\r\n        )\r\n    }\r\n}\r\n\r\n@Composable\r\ninternal fun AddCategoryDialog(\r\n    onDismiss: () -> Unit,\r\n    onSave: suspend (displayName: String, iconName: String, colorArgb: Int) -> Boolean,\r\n) {\r\n    var name by remember { mutableStateOf(\"\") }\r\n    var selectedIconName by remember { mutableStateOf(CategoryIconRegistry.all.first().name) }\r\n    var selectedColor by remember { mutableStateOf(colorPalette.first()) }\r\n    var saving by remember { mutableStateOf(false) }\r\n    val scope = rememberCoroutineScope()\r\n\r\n    Dialog(onDismissRequest = onDismiss) {\r\n        Surface(\r\n            shape = RoundedCornerShape(12.dp),\r\n            color = AppBackground,\r\n        ) {\r\n            Column {\r\n                // Green header\r\n                Surface(\r\n                    color = AppGreen,\r\n                    shape = RoundedCornerShape(topStart = 12.dp, topEnd = 12.dp),\r\n                ) {\r\n                    Row(\r\n                        modifier = Modifier\r\n                            .fillMaxWidth()\r\n                            .height(52.dp),\r\n                        horizontalArrangement = Arrangement.SpaceBetween,\r\n                        verticalAlignment = Alignment.CenterVertically,\r\n                    ) {\r\n                        Spacer(Modifier.width(48.dp))\r\n                        Text(\r\n                            text = \"New Category\",\r\n                            color = Color.White,\r\n                            style = MaterialTheme.typography.titleMedium,\r\n                            fontWeight = FontWeight.SemiBold,\r\n                        )\r\n                        IconButton(onClick = onDismiss) {\r\n                            Icon(Icons.Outlined.Close, contentDescription = \"Close\", tint = Color.White)\r\n                        }\r\n                    }\r\n                }\r\n\r\n                // Form\r\n                Column(\r\n                    modifier = Modifier.padding(horizontal = 16.dp, vertical = 14.dp),\r\n                    verticalArrangement = Arrangement.spacedBy(14.dp),\r\n                ) {\r\n                    TextField(\r\n                        value = name,\r\n                        onValueChange = { name = it },\r\n                        placeholder = { Text(\"Category name\", color = AppTextMuted) },\r\n                        modifier = Modifier.fillMaxWidth(),\r\n                        singleLine = true,\r\n                        colors = TextFieldDefaults.colors(\r\n                            focusedContainerColor = Color.Transparent,\r\n                            unfocusedContainerColor = Color.Transparent,\r\n                            focusedIndicatorColor = AppGreen,\r\n                            unfocusedIndicatorColor = Color(0xFFA4B0B1),\r\n                            focusedTextColor = AppTextPrimary,\r\n                            unfocusedTextColor = AppTextPrimary,\r\n                            cursorColor = AppGreen,\r\n                        ),\r\n                    )\r\n\r\n                    Column(verticalArrangement = Arrangement.spacedBy(6.dp)) {\r\n                        Text(\r\n                            \"Icon\",\r\n                            style = MaterialTheme.typography.labelLarge,\r\n                            color = AppTextSecondary,\r\n                        )\r\n                        LazyVerticalGrid(\r\n                            columns = GridCells.Fixed(5),\r\n                            modifier = Modifier.height(200.dp),\r\n                            verticalArrangement = Arrangement.spacedBy(4.dp),\r\n                            horizontalArrangement = Arrangement.spacedBy(4.dp),\r\n                        ) {\r\n                            items(CategoryIconRegistry.all, key = { it.name }) { option ->\r\n                                val isSelected = option.name == selectedIconName\r\n                                Box(\r\n                                    modifier = Modifier\r\n                                        .size(44.dp)\r\n                                        .clip(RoundedCornerShape(6.dp))\r\n                                        .background(\r\n                                            if (isSelected) selectedColor else AppBackground,\r\n                                        )\r\n                                        .border(\r\n                                            width = if (isSelected) 1.5.dp else 1.dp,\r\n                                            color = if (isSelected) selectedColor else AppDivider,\r\n                                            shape = RoundedCornerShape(6.dp),\r\n                                        )\r\n                                        .clickable(\r\n                                            interactionSource = remember { MutableInteractionSource() },\r\n                                            indication = null,\r\n                                        ) { selectedIconName = option.name },\r\n                                    contentAlignment = Alignment.Center,\r\n                                ) {\r\n                                    Icon(\r\n                                        imageVector = option.vector,\r\n                                        contentDescription = option.name,\r\n                                        tint = if (isSelected) Color.White else AppTextSecondary,\r\n                                        modifier = Modifier.size(22.dp),\r\n                                    )\r\n                                }\r\n                            }\r\n                        }\r\n                    }\r\n\r\n                    Column(verticalArrangement = Arrangement.spacedBy(6.dp)) {\r\n                        Text(\r\n                            \"Color\",\r\n                            style = MaterialTheme.typography.labelLarge,\r\n                            color = AppTextSecondary,\r\n                        )\r\n                        LazyRow(horizontalArrangement = Arrangement.spacedBy(8.dp)) {\r\n                            items(colorPalette) { color ->\r\n                                val isSelected = color == selectedColor\r\n                                Box(\r\n                                    modifier = Modifier\r\n                                        .size(32.dp)\r\n                                        .clip(CircleShape)\r\n                                        .background(color)\r\n                                        .then(\r\n                                            if (isSelected) {\r\n                                                Modifier.border(2.5.dp, AppGreen, CircleShape)\r\n                                            } else {\r\n                                                Modifier\r\n                                            },\r\n                                        )\r\n                                        .clickable(\r\n                                            interactionSource = remember { MutableInteractionSource() },\r\n                                            indication = null,\r\n                                        ) { selectedColor = color },\r\n                                )\r\n                            }\r\n                        }\r\n                    }\r\n                }\r\n\r\n                // Footer buttons\r\n                Row(\r\n                    modifier = Modifier\r\n                        .fillMaxWidth()\r\n                        .padding(horizontal = 8.dp, vertical = 4.dp),\r\n                    horizontalArrangement = Arrangement.End,\r\n                ) {\r\n                    TextButton(onClick = onDismiss) {\r\n                        Text(\"Cancel\", color = AppTextMuted)\r\n                    }\r\n                    Spacer(Modifier.width(4.dp))\r\n                    TextButton(\r\n                        onClick = {\r\n                            scope.launch {\r\n                                saving = true\r\n                                onSave(name.trim(), selectedIconName, selectedColor.toArgb())\r\n                                saving = false\r\n                            }\r\n                        },\r\n                        enabled = name.isNotBlank() && !saving,\r\n                    ) {\r\n                        Text(\r\n                            text = \"Save\",\r\n                            color = if (name.isNotBlank() && !saving) AppGreen else AppTextMuted,\r\n                            fontWeight = FontWeight.SemiBold,\r\n                        )\r\n                    }\r\n                }\r\n            }\r\n        }\r\n    }\r\n}\r\n\r\n@Composable\r\ninternal fun EditCategoryDialog(\r\n    category: CategoryItem,\r\n    onDismiss: () -> Unit,\r\n    onUpdate: suspend (categoryId: Long, displayName: String, iconName: String, colorArgb: Int) -> Boolean,\r\n    onDelete: suspend (categoryId: Long) -> Boolean,\r\n) {\r\n    var name by remember { mutableStateOf(category.displayName) }\r\n    var selectedIconName by remember { mutableStateOf(category.iconName ?: CategoryIconRegistry.all.first().name) }\r\n    var selectedColor by remember {\r\n        mutableStateOf(\r\n            if (category.colorArgb != null) Color(category.colorArgb)\r\n            else colorPalette.first()\r\n        )\r\n    }\r\n    var saving by remember { mutableStateOf(false) }\r\n    val scope = rememberCoroutineScope()\r\n\r\n    Dialog(onDismissRequest = onDismiss) {\r\n        Surface(\r\n            shape = RoundedCornerShape(12.dp),\r\n            color = AppBackground,\r\n        ) {\r\n            Column {\r\n                // Green header\r\n                Surface(\r\n                    color = AppGreen,\r\n                    shape = RoundedCornerShape(topStart = 12.dp, topEnd = 12.dp),\r\n                ) {\r\n                    Row(\r\n                        modifier = Modifier\r\n                            .fillMaxWidth()\r\n                            .height(52.dp),\r\n                        horizontalArrangement = Arrangement.SpaceBetween,\r\n                        verticalAlignment = Alignment.CenterVertically,\r\n                    ) {\r\n                        Spacer(Modifier.width(48.dp))\r\n                        Text(\r\n                            text = \"Edit Category\",\r\n                            color = Color.White,\r\n                            style = MaterialTheme.typography.titleMedium,\r\n                            fontWeight = FontWeight.SemiBold,\r\n                        )\r\n                        IconButton(onClick = onDismiss) {\r\n                            Icon(Icons.Outlined.Close, contentDescription = \"Close\", tint = Color.White)\r\n                        }\r\n                    }\r\n                }\r\n\r\n                // Form\r\n                Column(\r\n                    modifier = Modifier.padding(horizontal = 16.dp, vertical = 14.dp),\r\n                    verticalArrangement = Arrangement.spacedBy(14.dp),\r\n                ) {\r\n                    TextField(\r\n                        value = name,\r\n                        onValueChange = { name = it },\r\n                        placeholder = { Text(\"Category name\", color = AppTextMuted) },\r\n                        modifier = Modifier.fillMaxWidth(),\r\n                        singleLine = true,\r\n                        colors = TextFieldDefaults.colors(\r\n                            focusedContainerColor = Color.Transparent,\r\n                            unfocusedContainerColor = Color.Transparent,\r\n                            focusedIndicatorColor = AppGreen,\r\n                            unfocusedIndicatorColor = Color(0xFFA4B0B1),\r\n                            focusedTextColor = AppTextPrimary,\r\n                            unfocusedTextColor = AppTextPrimary,\r\n                            cursorColor = AppGreen,\r\n                        ),\r\n                    )\r\n\r\n                    Column(verticalArrangement = Arrangement.spacedBy(6.dp)) {\r\n                        Text(\r\n                            \"Icon\",\r\n                            style = MaterialTheme.typography.labelLarge,\r\n                            color = AppTextSecondary,\r\n                        )\r\n                        LazyVerticalGrid(\r\n                            columns = GridCells.Fixed(5),\r\n                            modifier = Modifier.height(200.dp),\r\n                            verticalArrangement = Arrangement.spacedBy(4.dp),\r\n                            horizontalArrangement = Arrangement.spacedBy(4.dp),\r\n                        ) {\r\n                            items(CategoryIconRegistry.all, key = { it.name }) { option ->\r\n                                val isSelected = option.name == selectedIconName\r\n                                Box(\r\n                                    modifier = Modifier\r\n                                        .size(44.dp)\r\n                                        .clip(RoundedCornerShape(6.dp))\r\n                                        .background(\r\n                                            if (isSelected) selectedColor else AppBackground,\r\n                                        )\r\n                                        .border(\r\n                                            width = if (isSelected) 1.5.dp else 1.dp,\r\n                                            color = if (isSelected) selectedColor else AppDivider,\r\n                                            shape = RoundedCornerShape(6.dp),\r\n                                        )\r\n                                        .clickable(\r\n                                            interactionSource = remember { MutableInteractionSource() },\r\n                                            indication = null,\r\n                                        ) { selectedIconName = option.name },\r\n                                    contentAlignment = Alignment.Center,\r\n                                ) {\r\n                                    Icon(\r\n                                        imageVector = option.vector,\r\n                                        contentDescription = option.name,\r\n                                        tint = if (isSelected) Color.White else AppTextSecondary,\r\n                                        modifier = Modifier.size(22.dp),\r\n                                    )\r\n                                }\r\n                            }\r\n                        }\r\n                    }\r\n\r\n                    Column(verticalArrangement = Arrangement.spacedBy(6.dp)) {\r\n                        Text(\r\n                            \"Color\",\r\n                            style = MaterialTheme.typography.labelLarge,\r\n                            color = AppTextSecondary,\r\n                        )\r\n                        LazyRow(horizontalArrangement = Arrangement.spacedBy(8.dp)) {\r\n                            items(colorPalette) { color ->\r\n                                val isSelected = color == selectedColor\r\n                                Box(\r\n                                    modifier = Modifier\r\n                                        .size(32.dp)\r\n 